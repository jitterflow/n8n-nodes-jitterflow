  "meta": {
    "description": "Lets people subscribe to a Telegram bot with /start and /stop, keeping the list in Google Sheets. Broadcasts written in the sheet are queued in Jitterflow, which delivers one message per subscriber at a steady pace with retries and no duplicates. A daily lane reads the dead-letter queue and marks subscribers who blocked the bot.",
    "setup": [
      "Add a Jitterflow endpoint pointing at https://api.telegram.org/bot<token>/sendMessage, paced at 5 a second or slower.",
      "Select your Telegram credential on the trigger and the three reply nodes.",
      "Select your Jitterflow API credential on the three Jitterflow nodes and paste the endpoint key.",
      "Create a sheet with Subscribers and Broadcasts tabs, select it on the eight Google Sheets nodes, then activate."
    ]
  }
